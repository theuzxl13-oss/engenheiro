# -----------------------------------------------------------------------------
# Copie para `.env.local` (desenvolvimento) e cadastre as mesmas variáveis
# na Vercel (Project Settings > Environment Variables).
# Sem as variáveis do Supabase o site roda em MODO DEMONSTRAÇÃO.
# -----------------------------------------------------------------------------

# URL pública do site (sem barra no final). Usada em SEO, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE SERVIDOR — nunca use o prefixo NEXT_PUBLIC_ nesta chave.
# Usada apenas para gravar solicitações de orçamento com validação e antispam.
SUPABASE_SERVICE_ROLE_KEY=

# Sal secreto para anonimizar IPs no limite de envios (gere com: openssl rand -hex 32)
RATE_LIMIT_SALT=

# (Opcional) Notificação por e-mail de novos orçamentos via Resend (https://resend.com)
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=
QUOTE_FROM_EMAIL=Site <orcamentos@seudominio.com.br>
